# Bionic Editor Environment Configuration
# Location: /etc/bionic-editor.env

# Arbitrary workspace directory served by Bionic Editor
WORKSPACE_DIR=/var/lib/bionic-editor/workspace

# Base specification file (default: SPEC.md)
BASE_SPEC=SPEC.md

# Network configuration
PORT=3000
HOST=0.0.0.0

# Optional URL slug prefix for reverse proxies (e.g., /ws-01)
BASE_URL=

# Service user for Linux installation (ensures coding mode, venv, and agent run as same user)
# SERVICE_USER=bionic

# Path to OpenCode executable (auto-detected if on PATH or ~/.opencode/bin/opencode)
# OPENCODE_BIN=/usr/local/bin/opencode

# AI Provider API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Agent Execution Limits (default is unlimited turns)
# MAX_TURNS=50
