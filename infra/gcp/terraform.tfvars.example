project_id            = "my-gcp-project-id"
region                = "us-central1"
zone                  = "us-central1-a"
domain                = "bionic.example.com"
profile               = "dev"
db_mode               = "local_docker"
bootstrap_admin_email = "you@example.com"
oidc_issuer           = "https://accounts.google.com"
oidc_client_id        = "your-google-oauth-client-id.apps.googleusercontent.com"
dns_provider          = "googleclouddns"
