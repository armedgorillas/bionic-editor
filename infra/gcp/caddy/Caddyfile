{
  email {$ACME_EMAIL}
}

hub.{$HUB_DOMAIN} {
  reverse_proxy 127.0.0.1:4000
}

*.editors.{$HUB_DOMAIN}, *.reports.{$HUB_DOMAIN} {
  tls {
    dns googleclouddns {
      gcp_project {$GCP_PROJECT_ID}
    }
  }
  reverse_proxy 127.0.0.1:4000
}

public-reports.{$HUB_DOMAIN} {
  handle /reports/*/latest* {
    rewrite * /_public{uri}
    reverse_proxy 127.0.0.1:4000
  }
  handle {
    rewrite * /{$GCP_STATIC_PUBLIC_BUCKET}{uri}
    reverse_proxy https://storage.googleapis.com {
      header_up Host storage.googleapis.com
    }
  }
}
