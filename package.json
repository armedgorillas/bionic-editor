{
  "name": "bioniceditor",
  "version": "0.1.0-beta.1",
  "description": "Scientific Document & Analysis IDE for Analytical Scientists",
  "main": "dist-server/index.js",
  "type": "module",
  "bin": {
    "bioniceditor": "./bin/bioniceditor.js",
    "bionic-editor": "./bin/bioniceditor.js"
  },
  "files": [
    "bin",
    "dist-server",
    "client/dist",
    "scripts/install-systemd.sh",
    "bionic-editor.service",
    "bionic-editor@.service",
    "bionic-editor.env.example",
    "README.md"
  ],
  "scripts": {
    "build:client": "npm --prefix client run build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "prepack": "npm run build",
    "package": "npm run build && npm pack",
    "start": "node dist-server/index.js",
    "dev": "tsx watch server/index.ts",
    "test": "node --test",
    "test:client": "npm --prefix client run lint"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@google/genai": "^2.27.0",
    "chokidar": "^5.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "openai": "^7.30.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
