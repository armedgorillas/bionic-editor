# Copy to `.env.deploy` (gitignored) and fill in your environment-specific values.
GCP_PROJECT_ID=my-gcp-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
ARTIFACT_REPO=bionic-hub
IMAGE_NAME=bionic-hub
IMAGE_TAG=latest
VPC_NETWORK=bionic-hub-vpc
EDITOR_SUBNET=bionic-editors-subnet
OPENCODE_VERSION=latest
# Optional: set to "sudo docker" if your local user isn't in the docker group
# DOCKER_CMD="sudo docker"
